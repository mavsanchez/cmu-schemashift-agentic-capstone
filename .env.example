# Local model provider (no cloud fallback)
SCHEMASHIFT_MODEL_PROVIDER=ollama
SCHEMASHIFT_CHAT_MODEL=gpt-oss:20b
SCHEMASHIFT_EMBEDDING_MODEL=bge-m3
SCHEMASHIFT_OLLAMA_BASE_URL=http://127.0.0.1:11434
SCHEMASHIFT_OLLAMA_KEEP_ALIVE=10m
SCHEMASHIFT_TEMPERATURE=0
SCHEMASHIFT_MODEL_MAX_ATTEMPTS=3

# Bounded graph reasoning
SCHEMASHIFT_MAX_MIGRATION_REVISIONS=10
SCHEMASHIFT_LOW_CONFIDENCE_THRESHOLD=0.80
SCHEMASHIFT_TOT_AMBIGUITY_MARGIN=0.10
SCHEMASHIFT_TOT_BRANCHING_FACTOR=3
SCHEMASHIFT_TOT_BEAM_WIDTH=2
SCHEMASHIFT_TOT_MAX_DEPTH=3

# PostgreSQL history and Redis Stack state/vector storage
SCHEMASHIFT_POSTGRES_DSN=postgresql://schemashift:schemashift@127.0.0.1:5432/schemashift
SCHEMASHIFT_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
SCHEMASHIFT_REDIS_URL=redis://127.0.0.1:6379/0
SCHEMASHIFT_REDIS_CHECKPOINT_PREFIX=schemashift:checkpoint
SCHEMASHIFT_REDIS_MEMORY_PREFIX=schemashift:memory
SCHEMASHIFT_REDIS_KNOWLEDGE_PREFIX=schemashift:knowledge
SCHEMASHIFT_REDIS_MEMORY_INDEX=schemashift-memory-v1
SCHEMASHIFT_REDIS_KNOWLEDGE_INDEX=schemashift-knowledge-v1
SCHEMASHIFT_RETRIEVAL_TOP_K=3
SCHEMASHIFT_EMBEDDING_DIMENSIONS=1024
SCHEMASHIFT_KNOWLEDGE_CHUNK_CHARS=1200
SCHEMASHIFT_KNOWLEDGE_CHUNK_OVERLAP_CHARS=150

# Deterministic validation and controlled local files
SCHEMASHIFT_FLOAT_ABSOLUTE_TOLERANCE=0.000001
SCHEMASHIFT_FLOAT_RELATIVE_TOLERANCE=0.000001
SCHEMASHIFT_QUERY_TIMEOUT_SECONDS=10
SCHEMASHIFT_RESULT_ROW_LIMIT=10000
SCHEMASHIFT_MISMATCH_SAMPLE_LIMIT=20
SCHEMASHIFT_UPLOAD_MAX_BYTES=26214400
SCHEMASHIFT_DATA_ROOT=data
SCHEMASHIFT_UPLOAD_ROOT=data/generated/uploads
SCHEMASHIFT_ARTIFACT_ROOT=data/generated/migrations

# UI
SCHEMASHIFT_GRADIO_HOST=127.0.0.1
SCHEMASHIFT_GRADIO_PORT=7860
